{
  "name": "@local/dsh-icon-studio",
  "version": "1.1.1",
  "author": "led",
  "description": "Restyles every icon DeepSeek Harness renders from one PNG: tray icon, About panel icon, Desktop/Start Menu shortcut icons, and the window/taskbar/Explorer icon embedded in the executable. Ships a settings page for upload-and-confirm, builds all Windows icon sizes, backs up and verifies what it replaces, and can restore the originals.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "icon",
    "theme",
    "windows",
    "tray",
    "taskbar",
    "customization"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "scripts/iconstudio.py",
    "locale/*.json",
    "docs",
    "README.md",
    "icon.svg",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MicroCapCap/dsh-icon-studio.git"
  },
  "homepage": "https://github.com/MicroCapCap/dsh-icon-studio",
  "bugs": {
    "url": "https://github.com/MicroCapCap/dsh-icon-studio/issues"
  }
}
